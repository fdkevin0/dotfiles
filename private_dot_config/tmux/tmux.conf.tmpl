# Shell
{{- if eq .chezmoi.os "darwin" }}
set -g default-shell /opt/homebrew/bin/fish
{{- else }}
set -g default-shell /usr/bin/fish
{{- end }}

# General
set -g default-terminal "tmux-256color"
set -g history-limit 50000
set -g mouse on
set -g renumber-windows on
set -g status-interval 5
set -sg escape-time 10
set -g visual-bell both

# Clipboard, passthrough & terminal capabilities (Ghostty + agy)
set -s set-clipboard on
set -g allow-passthrough on
set -g focus-events on
set -s extended-keys on
set -sq extended-keys-format csi-u
set -as terminal-features 'xterm*:extkeys:clipboard:RGB:hyperlinks:sync:usstyle'

# Keep current working directory on new window / split
bind c new-window -c "#{pane_current_path}"
bind '"' split-window -c "#{pane_current_path}"
bind % split-window -h -c "#{pane_current_path}"

# Plugins
set -g @plugin 'tmux-plugins/tpm'
set -g @plugin 'Ataraxy-Labs/opensessions'

{{- if eq .chezmoi.os "darwin" }}
run '/opt/homebrew/opt/tpm/share/tpm/tpm'
{{- else }}
run '~/.tmux/plugins/tpm/tpm'
{{- end }}
